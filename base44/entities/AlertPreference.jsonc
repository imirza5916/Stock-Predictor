{
  "name": "AlertPreference",
  "type": "object",
  "properties": {
    "ticker": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "alert_on_buy": {
      "type": "boolean",
      "default": true
    },
    "alert_on_sell": {
      "type": "boolean",
      "default": true
    },
    "alert_on_hold": {
      "type": "boolean",
      "default": false
    },
    "price_above": {
      "type": "number"
    },
    "price_below": {
      "type": "number"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "ticker",
    "email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}